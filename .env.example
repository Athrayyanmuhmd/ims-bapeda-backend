DATABASE_URL="postgresql://postgres:password@localhost:5432/ims_bapeda?schema=public"
JWT_SECRET="ganti-dengan-secret-yang-kuat-minimal-32-karakter"
PORT=3001

# Production: must match the deployed front-office origin (CORS).
FRONTEND_URL="http://localhost:3000"

# Wall-clock rules (WIB). Defaults match Indonesia office hours.
APP_TIMEZONE="Asia/Jakarta"
CHECKIN_START="07:00"
CHECKIN_END="09:00"
CHECKOUT_AUTO_AT="17:00"

