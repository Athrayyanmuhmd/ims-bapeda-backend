# Local default (Docker / local Postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ims_bapeda?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/ims_bapeda?schema=public"

# --- Supabase production (copy into Vercel → simagang-bapeda-api → Environment Variables) ---
# Project ref: brgyaorhucichpxtswtb
# Use Transaction pooler for DATABASE_URL (port 6543 + ?pgbouncer=true).
# Use Session pooler / direct for DIRECT_URL (migrations only).
# Percent-encode special characters in the password.
#
# DATABASE_URL="postgresql://postgres.brgyaorhucichpxtswtb:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.brgyaorhucichpxtswtb:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

JWT_SECRET="ganti-dengan-secret-yang-kuat-minimal-32-karakter"
PORT=3001

# Production: must match the deployed front-office origin (CORS).
# Local:
FRONTEND_URL="http://localhost:3000"
# Production (Vercel):
# FRONTEND_URL="https://simagang-bapeda.vercel.app"

# Wall-clock rules (WIB). Defaults match Indonesia office hours.
APP_TIMEZONE="Asia/Jakarta"
CHECKIN_START="07:00"
CHECKIN_END="09:00"
CHECKOUT_AUTO_AT="17:00"

