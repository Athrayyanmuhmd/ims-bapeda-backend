generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Transaction pooler (port 6543) for the running API — required on Vercel.
  url       = env("DATABASE_URL")
  // Session / direct connection for prisma migrate (optional locally & CI).
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(uuid())
  fullName    String
  email       String   @unique
  password    String
  phoneNumber String?
  status      String   @default("active")
  divisiId    String?
  roleId      String?
  divisi      Divisi?  @relation(fields: [divisiId], references: [id], onDelete: SetNull)
  role        Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pesertaAsBimbingan PesertaMagang[]
  penilaian          Penilaian[]
  absensiReviewed    Absensi[]       @relation("AbsensiReviewer")
}

model Divisi {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  pesertaMagang PesertaMagang[]
}

model Role {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

enum StatusMagang {
  AKTIF
  SELESAI
  BERHENTI
}

// Title-case to match existing absensi rows / UI labels (Hadir, Sakit, …).
enum Kehadiran {
  Hadir
  Sakit
  Izin
  Alpa
}

enum IzinStatus {
  PENDING
  APPROVED
  REJECTED
}

model PesertaMagang {
  id                   String       @id @default(uuid())
  name                 String
  email                String
  phoneNumber          String?
  nim                  String?
  // Portal peserta. Null = akun belum diaktifkan, peserta tidak bisa login.
  // Deliberately not a User row: peserta aren't staff, and reusing User would
  // hand them a role plus every staff endpoint that role unlocks.
  password             String?
  divisiId             String?
  instansiId           String?
  pembimbingLapanganId String?
  tanggalMulai         DateTime?
  tanggalSelesai       DateTime?
  status               StatusMagang @default(AKTIF)
  divisi               Divisi?      @relation(fields: [divisiId], references: [id], onDelete: SetNull)
  instansi             Instansi?    @relation(fields: [instansiId], references: [id], onDelete: SetNull)
  pembimbingLapangan   User?        @relation(fields: [pembimbingLapanganId], references: [id], onDelete: SetNull)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  absensi   Absensi[]
  logbook   Logbook[]
  penilaian Penilaian[]
  dokumen   Dokumen[]
}

model Absensi {
  id              String        @id @default(uuid())
  pesertaMagangId String
  kehadiran       Kehadiran
  tanggal         DateTime
  jamMasuk        DateTime?
  jamKeluar       DateTime?
  keterangan      String?
  // Portal self-report workflow. null = staff-authored / no izin request.
  // While PENDING, kehadiran holds the requested Izin/Sakit but rekap should
  // treat it as undecided until APPROVED (or Alpa after REJECTED).
  izinStatus      IzinStatus?
  izinJenis       Kehadiran?
  reviewedById    String?
  reviewedAt      DateTime?
  pesertaMagang   PesertaMagang @relation(fields: [pesertaMagangId], references: [id], onDelete: Cascade)
  reviewedBy      User?         @relation("AbsensiReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // One absensi row per peserta per hari. Duplicates made "% kehadiran" in the
  // rekap CSV and the printed laporan double-count the same day, and the daily
  // roster had no way to say which row was authoritative.
  //
  // Relies on `tanggal` always being UTC midnight, which lib/datetime.ts
  // guarantees (parseDateOnly). Migrating `tanggal` to `@db.Date` would enforce
  // that at the column level — worth doing if it ever drifts.
  @@unique([pesertaMagangId, tanggal])
}

model Instansi {
  id          String   @id @default(uuid())
  nama        String
  jenis       String
  alamat      String?
  namaPic     String?
  noHpPic     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pesertaMagang PesertaMagang[]
}

model Logbook {
  id              String        @id @default(uuid())
  pesertaMagangId String
  tanggal         DateTime
  kegiatan        String
  pesertaMagang   PesertaMagang @relation(fields: [pesertaMagangId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Same day invariant as Absensi — one logbook entry per peserta per calendar day.
  // Table kept as "Jurnal" so existing rows migrate without a rename.
  @@unique([pesertaMagangId, tanggal], map: "Jurnal_pesertaMagangId_tanggal_key")
  @@map("Jurnal")
}

model Penilaian {
  id              String        @id @default(uuid())
  pesertaMagangId String
  penilaiId       String
  nilai           Int
  komentar        String?
  pesertaMagang   PesertaMagang @relation(fields: [pesertaMagangId], references: [id], onDelete: Cascade)
  penilai         User          @relation(fields: [penilaiId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum JenisDokumen {
  SURAT_PENGANTAR
  SURAT_BALASAN
  SERTIFIKAT
  LAPORAN
  LAINNYA
}

model Dokumen {
  id              String        @id @default(uuid())
  pesertaMagangId String
  jenisDokumen    JenisDokumen
  namaFile        String
  urlFile         String
  pesertaMagang   PesertaMagang @relation(fields: [pesertaMagangId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
